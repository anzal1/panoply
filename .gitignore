# Rust
/target/
**/target/

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp

# Prototype build outputs and heavy files (kept out of git)
prototypes/**/node_modules/
prototypes/**/build/
prototypes/**/.build/
prototypes/**/dist/
prototypes/**/*.app/
prototypes/**/.dart_tool/
prototypes/**/Pods/
prototypes/**/src-tauri/target/
prototypes/**/src-tauri/gen/
prototypes/**/*.mp4
prototypes/**/*.mov
prototypes/llm-bench/results/
prototypes/**/snapshots/
prototypes/**/previews/

# Python
__pycache__/
*.pyc

# Downloaded models and engines (fetched on first use, never committed)
models-cache/
engines-cache/
*.onnx
*.gguf
*.tflite

# Kill test fixtures and agent outputs (regenerate with the scripts in prototypes/agent-killtest)
prototypes/agent-killtest/tasks/*/fixtures/
prototypes/agent-killtest/tasks/*/work/
prototypes/agent-killtest/results/run-*-work/

# Test corpus: files are fetched or generated on demand, only the manifests are committed
tests/corpus/cache/
tests/corpus/**/.part-*

# iLovePDF comparison outputs (downloaded and generated results)
prototypes/ilovepdf-compare/results/

# Build folders renamed so macOS Spotlight skips them (target is a symlink to target.noindex)
*.noindex/
**/target

# Caches, local config and tool output
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
.env
.env.*
!.env.example
*.profraw
*.profdata
*.rs.bk
Thumbs.db
.claude/

# Release workflow scratch folders (a local run of packaging/scripts leaves these behind)
/stage/
/staging/
/dist/
/release/
/manifests/
