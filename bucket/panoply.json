            "hash": "f6e03454b4de5ac4f7db81e5cc3926da1189242355f22d399cdc4433cd24b4ac",
            "extract_dir": "Panoply-0.3.0-beta-windows-x64"
        },
        "arm64": {
            "url": "https://github.com/anzal1/panoply/releases/download/v0.3.0-beta/Panoply-0.3.0-beta-windows-arm64.zip",
            "hash": "b9df7dd58344ad982cc2be595d20d7d16fefb2dc4fd863eae74f5e5dce070946",
            "extract_dir": "Panoply-0.3.0-beta-windows-arm64"
