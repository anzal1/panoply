        "panoply-desktop.exe"
    ],
    "shortcuts": [
        [
            "panoply-desktop.exe",
            "Panoply"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/anzal1/panoply/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v([\\d.]+(?:-beta(?:\\.\\d+)?)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/anzal1/panoply/releases/download/v$version/Panoply-$version-windows-x64.zip",
                "extract_dir": "Panoply-$version-windows-x64"
            },
            "arm64": {
                "url": "https://github.com/anzal1/panoply/releases/download/v$version/Panoply-$version-windows-arm64.zip",
                "extract_dir": "Panoply-$version-windows-arm64"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
