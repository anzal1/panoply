            "hash": "1c1c4e0eb3ba8c7b52a0285213e96f65dced40e6b9210e918d1e4238d0e2acfd",
            "extract_dir": "Panoply-0.3.0-windows-x64"
        },
        "arm64": {
            "url": "https://github.com/anzal1/panoply/releases/download/v0.3.0/Panoply-0.3.0-windows-arm64.zip",
            "hash": "16050b02e9f1ecbbad4e5007f975a5daa25d40cfa07bc4a6efc214f386a90335",
