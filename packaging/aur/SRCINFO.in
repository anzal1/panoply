pkgbase = panoply-bin
	pkgdesc = Every file tool in one fast app: PDF, image, audio and video tools and a file converter, all on your computer
	pkgver = @PKGVER@
	pkgrel = 1
	url = https://github.com/@REPO@
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	depends = alsa-lib
	depends = fontconfig
	depends = freetype2
	depends = gcc-libs
	depends = glibc
	depends = gtk3
	depends = libx11
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	depends = wayland
	provides = panoply
	conflicts = panoply
	options = !strip
	options = !debug
	source_x86_64 = Panoply-@VERSION@-linux-x64.tar.gz::https://github.com/@REPO@/releases/download/v@VERSION@/Panoply-@VERSION@-linux-x64.tar.gz
	sha256sums_x86_64 = @SHA256_LINUX_X64_TGZ@
	source_aarch64 = Panoply-@VERSION@-linux-arm64.tar.gz::https://github.com/@REPO@/releases/download/v@VERSION@/Panoply-@VERSION@-linux-arm64.tar.gz
	sha256sums_aarch64 = @SHA256_LINUX_ARM64_TGZ@

pkgname = panoply-bin
