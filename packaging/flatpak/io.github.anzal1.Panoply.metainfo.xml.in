<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.anzal1.Panoply</id>
  <name>Panoply</name>
  <summary>Every file tool in one fast app</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <description>
    <p>Panoply puts PDF, image, audio and video tools, and a universal file converter, in one open-source app. Nothing is uploaded; everything runs on your computer.</p>
  </description>
  <launchable type="desktop-id">io.github.anzal1.Panoply.desktop</launchable>
  <url type="homepage">https://github.com/@REPO@</url>
  <url type="bugtracker">https://github.com/@REPO@/issues</url>
  <!-- Flathub also needs screenshots (a few PNGs hosted at stable URLs) and a content_rating. -->
  <content_rating type="oars-1.1" />
  <releases>
    <release version="@VERSION@" date="@RELEASE_DATE@" />
  </releases>
</component>
