<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Only applied when signing with a Developer ID (hardened runtime). Ad-hoc builds ignore it. -->
  <!-- wasmtime compiles community modules to machine code in memory, then makes it executable. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- pdfium is downloaded on first use (checksum pinned) and loaded with dlopen. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
