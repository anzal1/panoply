# Maintainer: Anzal Abidi <anzalabidi@gmail.com>
# Filled by packaging/scripts/render_manifests.py from a finished GitHub release. Do not edit the copy in the AUR
# by hand: render again for the new tag and push PKGBUILD and .SRCINFO together.
pkgname=panoply-bin
_pkgver=0.2.0-beta
pkgver=0.2.0_beta
pkgrel=1
pkgdesc='Every file tool in one fast app: PDF, image, audio and video tools and a file converter, all on your computer'
arch=('x86_64' 'aarch64')
url='https://github.com/anzal1/panoply'
license=('MIT OR Apache-2.0')
# Libraries the prebuilt GPUI app needs at run time (see packaging/scripts/linux-package.sh). Several of them
# (libxkbcommon-x11, vulkan-icd-loader, gtk3, wayland, alsa-lib) are dlopen targets, not linked, so a tool
# that reads the binary's ELF headers will not list them.
depends=('alsa-lib' 'fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'gtk3' 'libx11' 'libxcb' 'libxkbcommon'
         'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland')
provides=("panoply=$pkgver")
conflicts=('panoply')
options=('!strip' '!debug')
source_x86_64=("Panoply-$_pkgver-linux-x64.tar.gz::https://github.com/anzal1/panoply/releases/download/v$_pkgver/Panoply-$_pkgver-linux-x64.tar.gz")
source_aarch64=("Panoply-$_pkgver-linux-arm64.tar.gz::https://github.com/anzal1/panoply/releases/download/v$_pkgver/Panoply-$_pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('41efc43a7c252aec671bfbf3a3e50e9550bfb5c805372a2eed9f0f8091a34f4b')
sha256sums_aarch64=('a4e0a66546b5ec80d1983f838362cae75e9dce7a0a48e374d4c53493af78af24')

package() {
  # The tarballs call the two architectures x64 and arm64.
  local _t=x64
  [ "$CARCH" = aarch64 ] && _t=arm64
  cd "$srcdir/Panoply-$_pkgver-linux-$_t"

  # Panoply finds its community modules in the folder next to the executable, so the programs and
  # the modules folder live together in /usr/lib/panoply and /usr/bin gets symlinks.
  install -d "$pkgdir/usr/lib/panoply" "$pkgdir/usr/bin"
  install -m755 bin/panoply bin/panoply-desktop "$pkgdir/usr/lib/panoply/"
  [ -d bin/modules ] && cp -R bin/modules "$pkgdir/usr/lib/panoply/modules"
  ln -s /usr/lib/panoply/panoply "$pkgdir/usr/bin/panoply"
  ln -s /usr/lib/panoply/panoply-desktop "$pkgdir/usr/bin/panoply-desktop"

  install -Dm644 share/applications/panoply.desktop "$pkgdir/usr/share/applications/panoply.desktop"
  (cd share/icons && find hicolor -type f -exec install -Dm644 {} "$pkgdir/usr/share/icons/{}" \;)

  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
