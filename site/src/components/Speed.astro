<section class="numbers" id="numbers">
  <div class="wrap">
    <header class="center rv">
      <span class="eyebrow">Speed</span>
      <h2 class="h2 h2s">Fast, because nothing<br>waits on a server.</h2>
    </header>
    <div class="stats">
      <div class="stat rv"><b class="grad" data-count="5">5<small>sec</small></b><p>to shrink a 300 MB PDF to 137 MB, using 11 MB of memory.</p></div>
      <div class="stat rv" style="--d:100ms"><b class="grad" data-count="0.96">0.96<small>sec</small></b><p>to trim a 4.6 GB, 73 minute video at keyframes.</p></div>
      <div class="stat rv" style="--d:200ms"><b class="grad" data-count="0.2">0.2<small>%</small></b><p>character error reading English text from a scan.</p></div>
    </div>
  </div>
</section>
