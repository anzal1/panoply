---
import "../../styles/global.css";
import ToolNav from "../../components/ToolNav.astro";
import Footer from "../../components/Footer.astro";
import { tools, groups } from "../../data/tools";
import presets from "../../data/exam-presets.json";
import rules from "../../data/passport-rules.json";
const title = "Free photo, PDF and video tools that run in your browser | Panoply";
const description = "Resize photos to an exact KB, make passport photos, remove backgrounds, merge and compress PDFs, read text from scans and more. Everything runs on your device and nothing is uploaded.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/product/icon.svg" /><link rel="canonical" href="https://panoply.anzalabidi.dev/tools/" />
    <meta name="theme-color" content="#0D0E12" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content="https://panoply.anzalabidi.dev/og.png" />
  </head>
  <body class="tool-page">
    <ToolNav />
    <main>
      <div class="wrap narrow">
        <h1 class="h2s" style="margin:0">Tools that run on your device</h1>
        <p class="sub">Free, in your browser.</p>
        <ul class="trust trust-l"><li><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 015 0v2"/></svg>On your device</li><li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6.5a9 9 0 0112 0M4.3 9a5.6 5.6 0 017.4 0M8 12.2h.01"/><path d="M3 3l10 10"/></svg>Works offline</li><li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8M4.8 7.2L8 10.4l3.2-3.2M3 13h10"/></svg>No upload</li></ul>
        {groups.map((g) => (
          <section class="tp-text" style="max-width:none">
            <h2>{g}</h2>
            <div class="tgrid">{tools.filter((t) => t.group === g).map((t) => <a class="tcard" href={`/tools/${t.slug}/`}><b>{t.h1}</b></a>)}</div>
          </section>
        ))}
        <details class="tp-details"><summary>Exam and portal photo sizes</summary>
          <section class="tp-text" style="max-width:none"><ul class="tp-links">{presets.map((p) => <li><a href={`/tools/resize-to-kb/${p.id}/`}>{p.authority.split(",")[0].replace(/\s*\(.*$/, "")} {p.field}</a></li>)}</ul></section>
        </details>
        <details class="tp-details"><summary>Passport and visa photo rules</summary>
          <section class="tp-text" style="max-width:none"><ul class="tp-links">{rules.map((r) => <li><a href={`/tools/passport-photo/${r.id}/`}>{r.country_name || r.country} {r.document}</a></li>)}</ul></section>
        </details>
      </div>
    </main>
    <Footer />
  </body>
</html>
<style is:global>
  .tool-page main { padding-top: 76px; padding-bottom: 40px; }
  .tool-page .tp-text h2 { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; margin: 36px 0 10px; color: var(--fg); }
  .tool-page .tp-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .tool-page .tp-links a { color: var(--link); font-size: 16px; }
  .tgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .tcard { display: block; background: var(--tile); border: 1px solid var(--hair); border-radius: 12px; padding: 16px; }
  .tcard b { display: block; font-size: 16px; font-weight: 600; color: var(--fg); }
  .tcard span { display: block; font-size: 14px; line-height: 1.4; color: var(--fg2); margin-top: 4px; }
  @media (hover: hover) and (pointer: fine) { .tcard:hover { border-color: var(--fg3); } }
  .tool-page .tp-details { margin-top: 20px; border-top: 1px solid var(--hair); }
  .tool-page .tp-details > summary { cursor: pointer; padding: 14px 0; font-size: 15px; font-weight: 600; color: var(--fg2); list-style: none; }
  .tool-page .tp-details > summary::after { content: "+"; float: right; color: var(--fg3); }
  .tool-page .tp-details[open] > summary::after { content: "\2212"; }
  .tool-page .tp-details > summary::-webkit-details-marker { display: none; }
  .tool-page .trust-l { margin: 12px 0 0; justify-content: flex-start; }
  .tool-page .trust svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .tool-page .trust { list-style: none; padding: 0; display: flex; gap: 6px 16px; flex-wrap: wrap; font-size: 12px; color: var(--fg2); }
  .tool-page .trust li { display: inline-flex; align-items: center; gap: 6px; }
</style>
